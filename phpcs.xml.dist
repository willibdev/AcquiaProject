<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="CS Drupal 11">
  <description>PHP CodeSniffer configuration for Drupal 11.</description>

  <arg name="extensions" value="php,module,inc,install,profile,theme,info,txt,yml"/>

  <!-- Set up ignores. -->
  <config name="ignore_warnings_on_exit" value="0" />
  <config name="ignore_errors_on_exit" value="0" />
  <arg name="ignore" value="*.js,*.css,*.scss,*.md,*.txt,*.TTF"/>
  <arg name="colors"/>

  <!-- Specify standards. -->
  <rule ref="Drupal" />
  <rule ref="DrupalPractice"/>

  <!-- Directories to scan -->
  <!-- <file>docroot/themes/custom</file> -->
  <file>docroot/modules/custom</file>

  <!-- Exclude third-party node modules or vendor code -->
  <exclude-pattern>docroot/modules/contrib</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>

  <!-- kill frivolous comments. -->
  <exclude name="Drupal.Commenting.ClassComment.Missing"/>
  <exclude name="Drupal.Commenting.DocComment.MissingShort" />
  <exclude name="Drupal.Commenting.FunctionComment.Missing" />
  <exclude name="Drupal.Commenting.FunctionComment.WrongStyle" />
  <exclude name="Drupal.Commenting.VariableComment.Missing" />
  <exclude name="Drupal.Commenting.VariableComment.MissingVar" />
  <exclude name="Drupal.Commenting.FileComment.Missing" />
  <exclude name="Drupal.Commenting.FunctionComment.MissingParamComment" />
  <exclude name="Drupal.WhiteSpace.OpenTagNewline.BlankLine" />
</ruleset>
